{
  "name": "@empjs/valtio",
  "version": "0.0.3",
  "description": "valtio store",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/empjs/valtio-best-practices.git",
    "directory": "packages/valtio"
  },
  "type": "module",
  "files": ["dist"],
  "maintainers": ["ckken"],
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["valtio", "store"],
  "main": "dist/index.js",
  "types": "dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "Ken",
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest run",
    "tc": "rstest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "happy-dom": "^20.14.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "derive-valtio": "^0.2.0",
    "valtio": "^2.3.0",
    "valtio-history": "^1.1.2"
  }
}
